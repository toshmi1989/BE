# Copy to `.env` / `.env.beta` on the target host. NEVER commit real secrets.

# --- Postgres (docker-compose.beta.yml) ---
POSTGRES_USER=be_beta
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=be_beta
POSTGRES_PORT=5433

# --- Backend ---
# Inside compose network use host `db`; from host machine use localhost:5433
DATABASE_URL=postgresql+psycopg://be_beta:CHANGE_ME_STRONG_DB_PASSWORD@localhost:5433/be_beta
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Auth (required for controlled beta)
AUTH_REQUIRED=true
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_MIN_24_CHARS
AUTH_TOKEN_TTL_SECONDS=86400

# Storage
DOCUMENT_STORAGE_ROOT=/data/documents
MAX_UPLOAD_BYTES=26214400

# Feature flags (assistive AI — prefer UI Settings for local cloud key)
AI_ENABLED=false
EXTERNAL_AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
# Optional fallback if not set via UI Настройки:
# OPENAI_API_KEY=
